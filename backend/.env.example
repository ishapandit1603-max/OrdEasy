# ===========================================================
# LLM (free by default - Groq, no billing/card required)
# 1. Get a free key at https://console.groq.com/keys
# 2. Paste it below
# ===========================================================
OPENAI_API_KEY=YOUR_GROQ_KEY_HERE
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# To use real OpenAI instead of Groq, change these two lines:
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ===========================================================
# Database (SQLite by default - no setup needed)
# ===========================================================
DATABASE_URL=sqlite:///./ordeasy.db

# ===========================================================
# Email ingestion (for continuous inbox polling)
# Gmail: use an App Password, not your normal password.
# Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on first - both free)
# ===========================================================
EMAIL_HOST=imap.gmail.com
EMAIL_USER=your_inbox@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FOLDER=INBOX
EMAIL_POLL_MINUTES=5
ENABLE_EMAIL_POLLING=false
